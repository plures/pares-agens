{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pares Agens",
  "version": "0.3.0",
  "identifier": "com.plures.pares-agens",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ui && npm ci && npm run build",
    "beforeDevCommand": "cd ui && npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pares Agens",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": "v2Compatible"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/plures/pares-agens/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
