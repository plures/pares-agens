// Praxis Intent Language (.px) grammar for pest
// See docs/PX-GRAMMAR.md for the full specification

WHITESPACE = _{ " " | "\t" }
COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* }

document = { SOI ~ (statement ~ NEWLINE*)* ~ EOI }

statement = _{ import_decl | fact_decl | rule_decl | constraint_decl | contract_decl | function_decl | trigger_decl }

// === Imports ===
import_decl = { "import" ~ rust_path ~ ("as" ~ ident)? }
rust_path = @{ ident ~ ("::" ~ ident)* }

// === Facts ===
fact_decl = { "fact" ~ ident ~ ":" ~ NEWLINE ~ field_list }
field_list = { (INDENT ~ field ~ NEWLINE)+ }
field = { ident ~ ":" ~ type_expr }

// === Rules ===
rule_decl = { "rule" ~ ident ~ ":" ~ NEWLINE ~ rule_body }
rule_body = { priority_clause? ~ when_clause ~ let_clause* ~ then_clause ~ capture_clause? }
priority_clause = { INDENT ~ "priority:" ~ integer ~ NEWLINE }
when_clause = { INDENT ~ "when:" ~ NEWLINE ~ condition_list }
condition_list = { (INDENT ~ INDENT ~ "- " ~ expr ~ NEWLINE)+ }
let_clause = { INDENT ~ "let" ~ ident ~ "=" ~ expr ~ NEWLINE }
then_clause = { INDENT ~ "then:" ~ NEWLINE ~ action_list }
action_list = { (INDENT ~ INDENT ~ "- " ~ action_stmt ~ NEWLINE)+ }
action_stmt = { conditional_action | simple_action }
simple_action = { "action:" ~ ident ~ param_pair* }
conditional_action = { "if" ~ expr ~ ":" ~ simple_action }
param_pair = { ident ~ ":" ~ value }
capture_clause = { INDENT ~ "capture:" ~ NEWLINE ~ (INDENT ~ INDENT ~ "- " ~ capture_entry ~ NEWLINE)+ }
capture_entry = { "fact:" ~ string ~ ("category:" ~ ident)? ~ ("tags:" ~ list_val)? }

// === Constraints ===
constraint_decl = { "constraint" ~ ident ~ ":" ~ NEWLINE ~ constraint_body }
constraint_body = { scope_clause? ~ when_expr ~ require_expr ~ severity_clause ~ message_clause? }
scope_clause = { INDENT ~ "scope:" ~ ident ~ NEWLINE }
when_expr = { INDENT ~ "when:" ~ expr ~ NEWLINE }
require_expr = { INDENT ~ "require:" ~ expr ~ NEWLINE }
severity_clause = { INDENT ~ "severity:" ~ severity_level ~ NEWLINE }
severity_level = { "error" | "warning" | "info" }
message_clause = { INDENT ~ "message:" ~ string ~ NEWLINE }

// === Contracts ===
contract_decl = { "contract" ~ ident ~ ":" ~ NEWLINE ~ contract_body }
contract_body = { given_clause? ~ when_desc? ~ then_desc? ~ threshold_clause? ~ examples_clause }
given_clause = { INDENT ~ "given:" ~ string ~ NEWLINE }
when_desc = { INDENT ~ "when:" ~ string ~ NEWLINE }
then_desc = { INDENT ~ "then:" ~ string ~ NEWLINE }
threshold_clause = { INDENT ~ "threshold:" ~ float ~ NEWLINE }
examples_clause = { INDENT ~ "examples:" ~ NEWLINE ~ example_list }
example_list = { (INDENT ~ INDENT ~ "- " ~ example ~ NEWLINE)+ }
example = { "input:" ~ value ~ NEWLINE ~ (INDENT ~ INDENT ~ INDENT)? ~ "expect:" ~ value ~ (NEWLINE ~ (INDENT ~ INDENT ~ INDENT)? ~ "threshold:" ~ float)? }

// === Functions ===
function_decl = { "function" ~ ident ~ "(" ~ param_list? ~ ")" ~ "->" ~ type_expr ~ ":" ~ NEWLINE ~ function_body }
function_body = { mode_clause? ~ docstring }
mode_clause = { INDENT ~ "mode:" ~ function_mode ~ NEWLINE }
function_mode = { "deterministic" | "probabilistic" | "hybrid" }
param_list = { param ~ ("," ~ param)* }
param = { ident ~ ":" ~ type_expr }
docstring = @{ INDENT ~ "\"\"\"" ~ (!("\"\"\"") ~ ANY)* ~ "\"\"\"" }

// === Triggers ===
trigger_decl = { "trigger" ~ ident ~ ":" ~ NEWLINE ~ trigger_body }
trigger_body = { on_clause ~ schedule_clause? ~ run_clause }
on_clause = { INDENT ~ "on:" ~ trigger_event ~ NEWLINE }
trigger_event = { "after_store" | "before_search" | "on_event(" ~ string ~ ")" | "timer" }
schedule_clause = { INDENT ~ "schedule:" ~ string ~ NEWLINE }
run_clause = { INDENT ~ "run:" ~ ident ~ NEWLINE }

// === Types ===
type_expr = { enum_type | list_type | optional_type | base_type }
base_type = { "bool" | "int" | "float" | "string" | "duration" }
enum_type = { "enum(" ~ ident ~ ("," ~ ident)* ~ ")" }
list_type = { "list[" ~ type_expr ~ "]" }
optional_type = { "optional[" ~ type_expr ~ "]" }

// === Expressions ===
expr = { comparison ~ (logic_op ~ comparison)* }
comparison = { term ~ (comp_op ~ term)? }
logic_op = { "and" | "or" }
comp_op = { "==" | "!=" | ">=" | "<=" | ">" | "<" }
term = { not_expr | call_expr | dotted_ident | value | "(" ~ expr ~ ")" }
not_expr = { "NOT" ~ term }
call_expr = { ident ~ "(" ~ (expr ~ ("," ~ expr)*)? ~ ")" }
dotted_ident = @{ ident ~ ("." ~ ident)* }

// === Values ===
value = { string | float | integer | boolean | list_val | map_val | ident }
string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" | "'" ~ (!"'" ~ ANY)* ~ "'" }
integer = @{ ASCII_DIGIT+ }
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
boolean = { "true" | "false" }
list_val = { "[" ~ (value ~ ("," ~ value)*)? ~ "]" }
map_val = { "{" ~ (ident ~ ":" ~ value ~ ("," ~ ident ~ ":" ~ value)*)? ~ "}" }

// === Tokens ===
ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
INDENT = _{ "  " }
NEWLINE = _{ "\n" | "\r\n" }
