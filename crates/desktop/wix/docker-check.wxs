<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX fragment: checks that Docker Desktop is installed before allowing
  Pares Agens to install.  Runs as a LaunchCondition so the installer
  exits with a clear message if Docker Desktop is not present.

  Registry paths checked (either per-machine OR per-user installs of
  Docker Desktop are accepted):
    HKLM\SOFTWARE\Docker Inc.\Docker Desktop  →  Version  (REG_SZ)
    HKCU\SOFTWARE\Docker Inc.\Docker Desktop  →  Version  (REG_SZ)

  The condition is skipped when upgrading/repairing an existing
  Pares Agens installation (Installed = 1).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>

    <!-- Search HKLM first (system-wide Docker Desktop install) -->
    <Property Id="DOCKER_DESKTOP_HKLM" Secure="yes">
      <RegistrySearch
        Id="DockerDesktopHKLM"
        Root="HKLM"
        Key="SOFTWARE\Docker Inc.\Docker Desktop"
        Name="Version"
        Type="raw" />
    </Property>

    <!-- Also check HKCU (per-user Docker Desktop install) -->
    <Property Id="DOCKER_DESKTOP_HKCU" Secure="yes">
      <RegistrySearch
        Id="DockerDesktopHKCU"
        Root="HKCU"
        Key="SOFTWARE\Docker Inc.\Docker Desktop"
        Name="Version"
        Type="raw" />
    </Property>

    <!--
      LaunchCondition: require Docker Desktop OR already installed
      (upgrading). The message is shown when the condition evaluates
      to FALSE, so we invert: fail when both registry keys are absent.
    -->
    <Condition
      Message="Docker Desktop is required by Pares Agens but was not found on this machine. Please install Docker Desktop from https://www.docker.com/products/docker-desktop/ and run this installer again.">
      <![CDATA[Installed OR DOCKER_DESKTOP_HKLM OR DOCKER_DESKTOP_HKCU]]>
    </Condition>

  </Fragment>
</Wix>
