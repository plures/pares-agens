# px-schema: pares-agens.spine@1#autonomous-dispatch-v1
# autonomous-dispatch.px — Task dispatch decisions (v3 dataflow)
#
# Replaces the Rust-side TaskExecutor.try_execute_next() logic.
# Pure decision logic: given evaluable tasks + clock, choose what to execute.
# The ONLY Rust boundary is emit_inbound_message (IO).
#
# Queue topology:
#
#   heartbeat_tick ─→ [evaluate_dispatch] ─→ dispatch_decision
#                           │                       │
#                           │                       ▼
#                           │            (Rust IO: emit_inbound_message)
#                           │
#                           └─ reads: evaluable tasks, cooldown state
#
#   task_dispatch ─→ [build_task_prompt] ─→ task_prompt
#        (from task-steering.px)                │
#                                              ▼
#                                   (Rust IO: emit_inbound_message)
#

# ═══════════════════════════════════════════════════════════════════
# Facts
# ═══════════════════════════════════════════════════════════════════

fact DispatchDecision:
  should_dispatch: bool
  task_id: string
  reason: string
  prompt: string

fact EvaluableTask:
  id: string
  description: string
  priority: int
  created_at: int
  last_evaluated_at: int
  attempts: int
  conditions: list
  subtasks: list

fact SteerResult:
  task_id: string
  message_to_agent: string

# The dataflow bindings below are the executable configuration. They are local
# rather than parser-skipped config so the compiler can prove every use.
# ═══════════════════════════════════════════════════════════════════
# Dataflow Procedures
# ═══════════════════════════════════════════════════════════════════

# Heartbeat entry: should we dispatch a task this tick?
procedure evaluate_dispatch(tick: int from "heartbeat_tick") -> DispatchDecision into "dispatch_decision":
  given: "Decide whether to dispatch an autonomous task on this heartbeat tick"

  define $min_evaluation_interval_seconds = 60
  define $max_attempts = 5

  # Rust supplies the durable task graph from the shared TaskManager. This
  # action is an IO read only; PX decides which runnable leaf to select.
  task_list_evaluable_graph {} -> $all_tasks

  when length($all_tasks) == 0:
    return {should_dispatch: false, task_id: null, reason: "no_pending_tasks", prompt: null}
  end

  # A parent is a fan-in node, not runnable work. Only childless tasks are
  # eligible for execution; the parent remains durable context for its leaves.
  filter_leaf_tasks {tasks: $all_tasks} -> $leaves

  when length($leaves) == 0:
    return {should_dispatch: false, task_id: null, reason: "no_runnable_leaf_tasks", prompt: null}
  end

  timestamp_now {} -> $now

  # Filter by cooldown
  filter_ready_tasks {tasks: $leaves, now: $now, cooldown: $min_evaluation_interval_seconds} -> $ready

  when length($ready) == 0:
    return {should_dispatch: false, task_id: null, reason: "all_cooling_down", prompt: null}
  end

  # Filter by max attempts
  filter_retriable {tasks: $ready, max: $max_attempts} -> $retriable

  when length($retriable) == 0:
    return {should_dispatch: false, task_id: null, reason: "all_exhausted", prompt: null}
  end

  # Select highest priority (lowest number), then oldest
  select_best_task {tasks: $retriable} -> $best

  get_field {object: $best, field: "id"} -> $best_id

  # Build the execution prompt
  build_task_prompt {task: $best} -> $prompt

  # One narrow Rust IO boundary persists the lifecycle claim and attempt.
  # The dispatch decision itself remains the result of this procedure.
  mark_task_in_progress {task_id: $best_id}
  dispatch_task {task_id: $best_id, prompt: $prompt}

  return {
    should_dispatch: true,
    task_id: $best_id,
    reason: "task_ready",
    prompt: $prompt
  }


# Steering entry: user confirmed/redirected a task — build prompt and dispatch
procedure build_steered_prompt(steer: SteerResult from "task_dispatch") -> string into "task_prompt":
  given: "Build execution prompt for a steered task"

  get_field {object: $steer, field: "message_to_agent"} -> $message_to_agent
  get_field {object: $steer, field: "task_id"} -> $task_id

  when $message_to_agent == null:
    return null  # cancelled task — don't dispatch
  end

  # Claim and dispatch use the same durable action seam as heartbeat dispatch.
  mark_task_in_progress {task_id: $task_id}
  dispatch_task {task_id: $task_id, prompt: $message_to_agent}

  return $message_to_agent


# ═══════════════════════════════════════════════════════════════════
# Utility Procedures
# ═══════════════════════════════════════════════════════════════════

# utility: called by evaluate_dispatch
procedure filter_leaf_tasks(tasks: list) -> list:
  given: "Keep only evaluable tasks without child tasks"
  define $leaves = []
  loop over $tasks as task:
    when length(task.subtasks) == 0:
      append $leaves $task
    end
  end
  return $leaves

# utility: called by evaluate_dispatch
procedure filter_ready_tasks(tasks: list, now: int, cooldown: int) -> list:
  given: "Filter tasks that have cooled down enough for re-evaluation"
  define $ready = []
  loop over $tasks as task:
    get_field {object: $task, field: "last_evaluated_at"} -> $last_evaluated_at
    when $last_evaluated_at == null:
      append $ready $task
    end
    when $last_evaluated_at != null:
      compute_elapsed {start: $last_evaluated_at, end: $now} -> $elapsed
      when $elapsed > $cooldown:
        append $ready $task
      end
    end
  end
  return $ready

# utility: called by evaluate_dispatch
procedure filter_retriable(tasks: list, max: int) -> list:
  given: "Filter tasks that haven't exhausted their retry budget"
  define $retriable = []
  loop over $tasks as task:
    when task.attempts < $max:
      append $retriable $task
    end
  end
  return $retriable

# utility: called by evaluate_dispatch
procedure select_best_task(tasks: list) -> EvaluableTask:
  given: "Select highest-priority task (lowest number = highest priority), then oldest"
  sort_by {items: $tasks, keys: ["priority", "created_at"], orders: ["asc", "asc"]} -> $sorted
  get_first_item {list: $sorted} -> $best
  return $best

# utility: called by evaluate_dispatch, build_steered_prompt
procedure build_task_prompt(task: EvaluableTask) -> string:
  given: "Build the execution prompt string for an autonomous task"

  get_field {object: $task, field: "description"} -> $description
  get_field {object: $task, field: "id"} -> $id
  get_field {object: $task, field: "priority"} -> $priority
  get_field {object: $task, field: "attempts"} -> $attempts
  get_field {object: $task, field: "conditions"} -> $conditions

  format_string {
    template: "[autonomous-task] Execute this task:
Task: {description}
ID: {id}
Priority: {priority}
Attempts: {attempts}
Conditions:
{conditions}

Work on this task using available tools. For work with multiple independently verifiable outcomes, call task_create_subtask with this task ID before implementation. The parent remains open until every child is terminal. When complete, call task_complete with this task ID; prose alone does not close the queue. If blocked, explain why.",
    vars: {
      description: $description,
      id: $id,
      priority: $priority,
      attempts: $attempts,
      conditions: $conditions
    }
  } -> $prompt

  return $prompt
